<script>
function navigate(pageId) {
  // Block dashboard access if countdown hasn't finished
  if (pageId === 'dashboard') {
    const expiry = parseInt(localStorage.getItem('wmh_countdown_expiry'));
    if (expiry && Date.now() < expiry) {
      alert(getLang() === 'he' ? 'לוח הבקרה נעול עד לסיום הספירה לאחור.' : 'Dashboard is locked until the countdown completes.');
      navigate('application');
      goToStep(4);
      return;
    }
    loadDashboardData();
  }

  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const targetPage = document.getElementById('page-' + pageId);
  if (targetPage) targetPage.classList.add('active');
  
  document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
  const activeLink = Array.from(document.querySelectorAll('.nav-link')).find(l => l.getAttribute('onclick') && l.getAttribute('onclick').includes(pageId));
  if (activeLink) activeLink.classList.add('active');
  
  window.scrollTo({ top: 0, behavior: 'smooth' });
  document.getElementById('navLinks').classList.remove('show');
}

function toggleMenu() { document.getElementById('navLinks').classList.toggle('show'); }

function setLanguage(lang) {
  const html = document.documentElement;
  const body = document.body;
  document.querySelectorAll('[data-en]').forEach(el => {
    const text = el.getAttribute('data-' + lang);
    if (text !== null) { if (el.tagName === 'OPTION') el.textContent = text; else el.innerHTML = text; }
  });
  document.querySelectorAll('[data-en-ph]').forEach(el => {
    const ph = el.getAttribute('data-' + lang + '-ph');
    if (ph !== null) el.placeholder = ph;
  });
  if (lang === 'he') {
    html.setAttribute('dir', 'rtl'); html.setAttribute('lang', 'he');
    body.classList.add('rtl'); body.classList.remove('ltr');
  } else {
    html.setAttribute('dir', 'ltr'); html.setAttribute('lang', 'en');
    body.classList.add('ltr'); body.classList.remove('rtl');
  }
  document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.lang === lang));
  localStorage.setItem('wmh_lang', lang);
}

let currentSlide = 0;
const totalSlides = 3;
function changeSlide(direction) { currentSlide = (currentSlide + direction + totalSlides) % totalSlides; setSlide(currentSlide); }
function setSlide(index) {
  currentSlide = index;
  document.querySelectorAll('.gallery-slide').forEach((s, i) => s.classList.toggle('active', i === index));
  document.querySelectorAll('.gallery-thumb').forEach((t, i) => t.classList.toggle('active', i === index));
  const activeSlide = document.querySelectorAll('.gallery-slide')[index];
  if (activeSlide) {
    const caption = activeSlide.getAttribute('data-caption');
    const captionEl = document.getElementById('galleryCaption');
    if (captionEl && caption) captionEl.textContent = caption;
  }
}

function goToStep(step) {
  if (step === 2 || step === 3) {
    const repName = document.getElementById('repName').value;
    const repEmail = document.getElementById('repEmail').value;
    const repPhone = document.getElementById('repPhone').value;
    const repRelationship = document.getElementById('repRelationship').value;
    const repCountry = document.getElementById('repCountry').value;
    if (!repName || !repEmail || !repPhone || repRelationship === 'Select...' || repCountry === 'Select...') {
      alert(getLang() === 'he' ? 'נא למלא את כל השדות הנדרשים בשלב 1' : 'Please fill in all required fields in Step 1');
      goToStep(1); return;
    }
  }
  if (step === 3) {
    const soldierName = document.getElementById('soldierName').value;
    const soldierService = document.getElementById('soldierService').value;
    const soldierBranch = document.getElementById('soldierBranch').value;
    const soldierCountry = document.getElementById('soldierCountry').value;
    if (!soldierName || !soldierService || soldierBranch === 'Select...' || soldierCountry === 'Select...') {
      alert(getLang() === 'he' ? 'נא למלא את כל השדות הנדרשים בשלב 2' : 'Please fill in all required fields in Step 2');
      goToStep(2); return;
    }
    populateReview();
  }
  document.querySelectorAll('.form-step').forEach(s => s.style.display = 'none');
  const targetStep = document.getElementById('formStep' + step);
  if (targetStep) targetStep.style.display = 'block';
  document.querySelectorAll('.step-node').forEach((n, i) => {
    n.classList.remove('active', 'done');
    if (i + 1 < step) n.classList.add('done');
    else if (i + 1 === step) n.classList.add('active');
  });
  document.querySelectorAll('.step-line').forEach((l, i) => l.classList.toggle('done', i + 1 < step));
}

function populateReview() {
  const reviewPanel = document.getElementById('reviewPanel');
  const data = {
    'Representative Name': document.getElementById('repName').value,
    'Relationship': document.getElementById('repRelationship').value,
    'Email': document.getElementById('repEmail').value,
    'Telephone': document.getElementById('repPhone').value,
    'Country': document.getElementById('repCountry').value,
    'Soldier Name': document.getElementById('soldierName').value,
    'Service Number': document.getElementById('soldierService').value,
    'Branch': document.getElementById('soldierBranch').value,
    'Country of Service': document.getElementById('soldierCountry').value
  };
  let html = '<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">';
  for (const [key, value] of Object.entries(data)) {
    html += `<div style="padding:12px; background:white; border-radius:6px; border-left:3px solid var(--gold);"><strong style="color:var(--grey); font-size:0.8rem; text-transform:uppercase;">${key}:</strong><br><span style="color:var(--navy); font-weight:600;">${value || '—'}</span></div>`;
  }
  html += '</div>';
  reviewPanel.innerHTML = html;
  const lang = localStorage.getItem('wmh_lang') || 'en';
  setLanguage(lang);
}

function submitApplication() {
  if (!document.getElementById('privacyAck').checked) {
    alert(getLang() === 'he' ? 'נא לאשר את מדיניות הפרטיות' : 'Please acknowledge the privacy policy'); return;
  }
  if (localStorage.getItem('wmh_app_submitted') === 'true') {
    goToStep(4); resumeCountdown(); return;
  }
  // Simulate Database Save
  const refNum = 'WH-2026-' + Math.floor(1000 + Math.random() * 9000);
  const timestamp = Date.now();
  const expiry = timestamp + (2 * 60 * 1000); // 2 minutes
  
  localStorage.setItem('wmh_app_ref', refNum);
  localStorage.setItem('wmh_app_submitted', 'true');
  localStorage.setItem('wmh_countdown_start', timestamp.toString());
  localStorage.setItem('wmh_countdown_expiry', expiry.toString());
  
  goToStep(4);
  startCountdown();
}

let countdownInterval;
function startCountdown() {
  const expiry = parseInt(localStorage.getItem('wmh_countdown_expiry'));
  if (!expiry) return;
  const ring = document.getElementById('countdownRing');
  const timeDisplay = document.getElementById('countdownTime');
  const completeBox = document.getElementById('countdownComplete');
  const dashboardBtn = document.getElementById('dashboardBtn');
  const ringCircumference = 565.48;
  clearInterval(countdownInterval);
  countdownInterval = setInterval(() => {
    const now = Date.now();
    const remaining = Math.max(0, expiry - now);
    const remainingSec = Math.ceil(remaining / 1000);
    if (remaining <= 0) {
      clearInterval(countdownInterval);
      timeDisplay.textContent = '00:00';
      ring.style.strokeDashoffset = ringCircumference;
      completeBox.classList.add('show');
      dashboardBtn.style.display = 'inline-flex';
      return;
    }
    const mins = Math.floor(remainingSec / 60);
    const secs = remainingSec % 60;
    timeDisplay.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    const progress = remaining / (2 * 60 * 1000);
    ring.style.strokeDashoffset = ringCircumference * (1 - progress);
  }, 1000);
}

function resumeCountdown() {
  const expiry = parseInt(localStorage.getItem('wmh_countdown_expiry'));
  if (!expiry) return;
  const now = Date.now();
  if (now >= expiry) {
    document.getElementById('countdownTime').textContent = '00:00';
    document.getElementById('countdownRing').style.strokeDashoffset = 565.48;
    document.getElementById('countdownComplete').classList.add('show');
    document.getElementById('dashboardBtn').style.display = 'inline-flex';
  } else {
    startCountdown();
  }
}

function getLang() { return localStorage.getItem('wmh_lang') || 'en'; }

function loadDashboardData() {
  const ref = localStorage.getItem('wmh_app_ref') || 'WH-2026-XXXX';
  const submitted = localStorage.getItem('wmh_app_submitted') === 'true';
  document.getElementById('statRef').textContent = ref;
  if (submitted) {
    const start = parseInt(localStorage.getItem('wmh_countdown_start'));
    const days = Math.floor((Date.now() - start) / (1000 * 60 * 60 * 24));
    document.getElementById('statDays').textContent = days;
  } else {
    document.getElementById('statDays').textContent = '—';
  }
}

function submitDelivery() {
  const checks = document.querySelectorAll('.auth-check');
  let allChecked = true;
  checks.forEach(c => { if (!c.checked) allChecked = false; });
  if (!allChecked) {
    alert(getLang() === 'he' ? 'נא לסמן את כל ארבע תיבות ההרשאה' : 'Please check all four authorization checkboxes'); return;
  }
  const name = document.getElementById('delName').value;
  const phone = document.getElementById('delPhone').value;
  const city = document.getElementById('delCity').value;
  const country = document.getElementById('delCountry').value;
  if (!name || !phone || !city || country === 'Select...') {
    alert(getLang() === 'he' ? 'נא למלא את כל השדות הנדרשים' : 'Please fill in all required fields'); return;
  }
  // Simulate saving to DB
  document.getElementById('deliveryFormPanel').style.display = 'none';
  document.getElementById('deliveryConfirmation').style.display = 'block';
  document.getElementById('deliveryConfirmation').scrollIntoView({ behavior: 'smooth' });
}

function sendDeliveryEmail() {
  const appRef = localStorage.getItem('wmh_app_ref') || 'WH-2026-XXXX';
  const name = document.getElementById('delName').value;
  const street = document.getElementById('delStreet').value;
  const city = document.getElementById('delCity').value;
  const state = document.getElementById('delState').value;
  const postal = document.getElementById('delPostal').value;
  const country = document.getElementById('delCountry').value;
  const phone = document.getElementById('delPhone').value;
  const instructions = document.getElementById('delInstructions').value;

  const subject = `Delivery Information — Application Reference ${appRef}`;
  const body = `Hello Support Team,\n\nI have submitted my delivery information.\n\nApplication Reference: ${appRef}\nRecipient Name: ${name}\nDelivery Address: ${street}, ${city}, ${state} ${postal}, ${country}\nTelephone: ${phone}\nDelivery Instructions: ${instructions}\n\nPlease confirm receipt.\n\nThank you.`;
  
  window.location.href = `mailto:humanitarianaidservicesaccess@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}

function verifyApplication() {
  const input = document.getElementById('verifyInput').value.trim();
  const resultBox = document.getElementById('verifyResult');
  const icon = document.getElementById('verifyIcon');
  const title = document.getElementById('verifyTitle');
  const message = document.getElementById('verifyMessage');
  const lang = getLang();
  resultBox.className = 'verify-result';
  if (!input) {
    resultBox.classList.add('show', 'error');
    icon.className = 'fas fa-times-circle';
    title.textContent = lang === 'he' ? 'שגיאה' : 'Error';
    message.textContent = lang === 'he' ? 'נא להזין מספר ייחוס.' : 'Please enter a reference.';
    return;
  }
  // Simulate DB Query
  const savedRef = localStorage.getItem('wmh_app_ref');
  const submitted = localStorage.getItem('wmh_app_submitted') === 'true';
  
  if (submitted && input === savedRef) {
    resultBox.classList.add('show', 'pending');
    icon.className = 'fas fa-clock';
    title.textContent = lang === 'he' ? 'סטטוס: באימות' : 'Status: UNDER VERIFICATION';
    message.textContent = lang === 'he' ? 'בקשה זו נמצאת כעת באימות.' : 'This application is currently under verification.';
  } else if (input.startsWith('WH-2026')) {
    resultBox.classList.add('show', 'success');
    icon.className = 'fas fa-inbox';
    title.textContent = lang === 'he' ? 'סטטוס: הבקשה התקבלה' : 'Status: APPLICATION RECEIVED';
    message.textContent = lang === 'he' ? 'הבקשה התקבלה וממתינה לסקירה.' : 'The application has been received and is awaiting review.';
  } else {
    resultBox.classList.add('show', 'error');
    icon.className = 'fas fa-times-circle';
    title.textContent = lang === 'he' ? 'לא נמצאה בקשה' : 'No Matching Application Found';
    message.textContent = lang === 'he' ? 'מספר הייחוס אינו תואם.' : 'The reference does not match any recorded application.';
  }
}

function toggleFaq(element) {
  const item = element.parentElement;
  const wasOpen = item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
  if (!wasOpen) item.classList.add('open');
}

document.addEventListener('DOMContentLoaded', () => {
  const savedLang = localStorage.getItem('wmh_lang') || 'en';
  setLanguage(savedLang);
  
  // Resume countdown if user was in the middle of it
  if (localStorage.getItem('wmh_app_submitted') === 'true') {
    const expiry = parseInt(localStorage.getItem('wmh_countdown_expiry'));
    if (expiry && Date.now() < expiry) {
      const appPage = document.getElementById('page-application');
      if (appPage && appPage.classList.contains('active')) {
        goToStep(4); resumeCountdown();
      }
    }
  }
  
  // Auto-advance Tesla gallery
  setInterval(() => {
    if (document.getElementById('page-recognition').classList.contains('active')) {
      changeSlide(1);
    }
  }, 6000);
});
</script>
</body>
</html>
