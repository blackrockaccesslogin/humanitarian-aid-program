<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Wounded Military Heroes Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Heebo:wght@300;400;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<style>
:root {
  --navy: #101D35; --navy-deep: #0A1424; --navy-darker: #050B18; --military-blue: #172B4D;
  --gold: #B89550; --gold-bright: #D4AF37; --gold-champagne: #E4CD91; --gold-pale: #F7E7B4; --gold-deep: #8B6F2C;
  --gold-gradient: linear-gradient(135deg, #F7E7B4 0%, #D4AF37 50%, #B89550 100%);
  --ivory: #F8F6F0; --white: #FFFFFF; --silver: #B8BCC4; --green: #507B60; --green-light: #6B9B7E; --grey: #858B96; --grey-light: #E0E3E8; --red: #B22234;
  --shadow-soft: 0 4px 24px rgba(0,0,0,0.08); --shadow-medium: 0 8px 32px rgba(0,0,0,0.12); --shadow-dark: 0 16px 48px rgba(0,0,0,0.4); --shadow-gold: 0 8px 32px rgba(184,149,80,0.25);
}
* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; -webkit-text-size-adjust:100%; }
body { font-family:'Inter',sans-serif; background:var(--navy); color:#2c2c2c; line-height:1.6; overflow-x:hidden; min-height:100vh; }

/* Flag Background */
.flag-bg { position:fixed; top:0; left:0; width:100vw; height:100vh; z-index:-2; opacity:0.22; pointer-events:none; background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1235 650" preserveAspectRatio="xMidYMid slice"><rect width="1235" height="650" fill="%23fff"/><g fill="%23b22234"><rect width="1235" height="50" y="0"/><rect width="1235" height="50" y="100"/><rect width="1235" height="50" y="200"/><rect width="1235" height="50" y="300"/><rect width="1235" height="50" y="400"/><rect width="1235" height="50" y="500"/><rect width="1235" height="50" y="600"/></g><rect width="494" height="350" fill="%233c3b6e"/><g fill="%23fff"><circle cx="30" cy="30" r="12"/><circle cx="90" cy="30" r="12"/><circle cx="150" cy="30" r="12"/><circle cx="210" cy="30" r="12"/><circle cx="270" cy="30" r="12"/><circle cx="330" cy="30" r="12"/><circle cx="390" cy="30" r="12"/><circle cx="450" cy="30" r="12"/><circle cx="60" cy="60" r="12"/><circle cx="120" cy="60" r="12"/><circle cx="180" cy="60" r="12"/><circle cx="240" cy="60" r="12"/><circle cx="300" cy="60" r="12"/><circle cx="360" cy="60" r="12"/><circle cx="420" cy="60" r="12"/><circle cx="30" cy="90" r="12"/><circle cx="90" cy="90" r="12"/><circle cx="150" cy="90" r="12"/><circle cx="210" cy="90" r="12"/><circle cx="270" cy="90" r="12"/><circle cx="330" cy="90" r="12"/><circle cx="390" cy="90" r="12"/><circle cx="450" cy="90" r="12"/><circle cx="60" cy="120" r="12"/><circle cx="120" cy="120" r="12"/><circle cx="180" cy="120" r="12"/><circle cx="240" cy="120" r="12"/><circle cx="300" cy="120" r="12"/><circle cx="360" cy="120" r="12"/><circle cx="420" cy="120" r="12"/><circle cx="30" cy="150" r="12"/><circle cx="90" cy="150" r="12"/><circle cx="150" cy="150" r="12"/><circle cx="210" cy="150" r="12"/><circle cx="270" cy="150" r="12"/><circle cx="330" cy="150" r="12"/><circle cx="390" cy="150" r="12"/><circle cx="450" cy="150" r="12"/><circle cx="60" cy="180" r="12"/><circle cx="120" cy="180" r="12"/><circle cx="180" cy="180" r="12"/><circle cx="240" cy="180" r="12"/><circle cx="300" cy="180" r="12"/><circle cx="360" cy="180" r="12"/><circle cx="420" cy="180" r="12"/><circle cx="30" cy="210" r="12"/><circle cx="90" cy="210" r="12"/><circle cx="150" cy="210" r="12"/><circle cx="210" cy="210" r="12"/><circle cx="270" cy="210" r="12"/><circle cx="330" cy="210" r="12"/><circle cx="390" cy="210" r="12"/><circle cx="450" cy="210" r="12"/><circle cx="60" cy="240" r="12"/><circle cx="120" cy="240" r="12"/><circle cx="180" cy="240" r="12"/><circle cx="240" cy="240" r="12"/><circle cx="300" cy="240" r="12"/><circle cx="360" cy="240" r="12"/><circle cx="420" cy="240" r="12"/><circle cx="30" cy="270" r="12"/><circle cx="90" cy="270" r="12"/><circle cx="150" cy="270" r="12"/><circle cx="210" cy="270" r="12"/><circle cx="270" cy="270" r="12"/><circle cx="330" cy="270" r="12"/><circle cx="390" cy="270" r="12"/><circle cx="450" cy="270" r="12"/><circle cx="60" cy="300" r="12"/><circle cx="120" cy="300" r="12"/><circle cx="180" cy="300" r="12"/><circle cx="240" cy="300" r="12"/><circle cx="300" cy="300" r="12"/><circle cx="360" cy="300" r="12"/><circle cx="420" cy="300" r="12"/><circle cx="30" cy="330" r="12"/><circle cx="90" cy="330" r="12"/><circle cx="150" cy="330" r="12"/><circle cx="210" cy="330" r="12"/><circle cx="270" cy="330" r="12"/><circle cx="330" cy="330" r="12"/><circle cx="390" cy="330" r="12"/><circle cx="450" cy="330" r="12"/></g></svg>'); background-size:cover; background-position:center; background-repeat:no-repeat; }
.flag-overlay { position:fixed; top:0; left:0; width:100vw; height:100vh; z-index:-1; pointer-events:none; background:linear-gradient(135deg, rgba(255,255,255,0.65), rgba(248,246,240,0.75)); }

/* RTL Support */
body.rtl { font-family:'Heebo',sans-serif; }
body.rtl h1, body.rtl h2, body.rtl h3, body.rtl h4, body.rtl h5, body.rtl .btn, body.rtl .nav-link, body.rtl .eyebrow, body.rtl .brand-text { font-family:'Heebo',sans-serif !important; letter-spacing:0 !important; text-transform:none !important; }
body.rtl .italic-serif { font-family:'Heebo',sans-serif !important; font-style:normal !important; }
body.rtl .timeline::before { inset-inline-start:0; }
body.rtl .timeline-item { padding-inline-start:40px; padding-inline-end:0; }
body.rtl .timeline-dot { inset-inline-start:-49px; }
body.rtl .timeline-card { border-inline-start:3px solid var(--gold); border-inline-end:none; }
body.rtl .form-grid-2 { direction:rtl; }

/* Header */
header { position:fixed; top:0; left:0; width:100%; z-index:1000; background:rgba(248,246,240,0.96); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); border-bottom:2px solid var(--gold); box-shadow:var(--shadow-soft); }
.nav-container { max-width:1440px; margin:0 auto; padding:12px 24px; }
.nav-top { display:flex; justify-content:space-between; align-items:center; }
.brand { display:flex; align-items:center; gap:12px; cursor:pointer; }
.medal-emblem { width:44px; height:44px; flex-shrink:0; }
.medal-emblem svg { width:100%; height:100%; }
.brand-text { font-family:'Cinzel',serif; font-weight:700; font-size:1.1rem; color:var(--navy); letter-spacing:1.5px; white-space:nowrap; }
.nav-right { display:flex; gap:16px; align-items:center; }
.lang-selector { display:flex; border:1.5px solid var(--gold); border-radius:8px; overflow:hidden; }
.lang-btn { padding:8px 14px; border:none; background:transparent; cursor:pointer; font-size:0.85rem; font-weight:600; color:var(--navy); transition:all 0.3s; }
.lang-btn.active { background:var(--navy); color:var(--gold-bright); }
.mobile-toggle { display:none; font-size:1.4rem; cursor:pointer; color:var(--navy); background:none; border:none; padding:8px; }
.nav-links { display:flex; gap:0; margin-top:10px; flex-wrap:wrap; border-top:1px solid rgba(184,149,80,0.3); padding-top:10px; }
.nav-link { font-family:'Cinzel',serif; font-size:0.72rem; font-weight:600; text-transform:uppercase; letter-spacing:1.2px; color:var(--navy); cursor:pointer; padding:6px 14px; border-radius:4px; transition:all 0.3s; border-bottom:2px solid transparent; white-space:nowrap; }
.nav-link:hover { background:rgba(184,149,80,0.1); color:var(--gold-deep); }
.nav-link.active { border-bottom-color:var(--gold-bright); color:var(--gold-deep); }

/* Layout */
main { padding-top:160px; padding-bottom:80px; max-width:1440px; margin:0 auto; padding-inline:24px; }
.page { display:none; animation:fadeInUp 0.6s ease forwards; }
.page.active { display:block; }
@keyframes fadeInUp { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:translateY(0); } }
@keyframes floatMedal { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-12px); } }
@keyframes pulse { 0%,100% { box-shadow:0 0 24px rgba(212,175,55,0.3), inset 0 0 16px rgba(212,175,55,0.1); } 50% { box-shadow:0 0 48px rgba(212,175,55,0.7), inset 0 0 28px rgba(212,175,55,0.2); } }
@keyframes rotateHalo { to { transform:translate(-50%,-50%) rotate(360deg); } }

/* Panels */
.panel { background:rgba(255,255,255,0.97); border-radius:12px; box-shadow:var(--shadow-soft); padding:48px; margin-bottom:32px; border:1px solid rgba(184,149,80,0.2); }
.dark-panel { background:var(--navy); color:var(--white); position:relative; overflow:hidden; border:1px solid rgba(184,149,80,0.3); }
.dark-panel::before { content:''; position:absolute; top:0; left:0; width:100%; height:100%; background:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1235 650"><rect width="1235" height="650" fill="%23fff"/><g fill="%23b22234"><rect width="1235" height="50" y="0"/><rect width="1235" height="50" y="100"/><rect width="1235" height="50" y="200"/><rect width="1235" height="50" y="300"/><rect width="1235" height="50" y="400"/><rect width="1235" height="50" y="500"/><rect width="1235" height="50" y="600"/></g><rect width="494" height="350" fill="%233c3b6e"/></svg>'); opacity:0.08; z-index:0; }
.dark-panel > * { position:relative; z-index:1; }

/* Typography */
.eyebrow { color:var(--gold-deep); font-weight:700; font-family:'Cinzel',serif; text-transform:uppercase; letter-spacing:2.5px; font-size:0.78rem; margin-bottom:12px; }
h1, h2, h3, h4 { font-family:'Cinzel',serif; color:var(--navy); line-height:1.2; }
h1 { font-size:clamp(1.8rem,4vw,2.8rem); margin-bottom:16px; }
h2 { font-size:clamp(1.5rem,3vw,2.2rem); margin-bottom:20px; }
h3 { font-size:1.2rem; margin-bottom:12px; }
h4 { font-size:1rem; margin-bottom:8px; }
p { margin-bottom:16px; }
.italic-serif { font-family:'Cormorant Garamond',serif; font-style:italic; }
.gold-text { background:var(--gold-gradient); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.text-center { text-align:center; }
.muted { color:var(--grey); font-size:0.9rem; }

/* Buttons */
.btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:14px 28px; font-family:'Cinzel',serif; font-weight:600; font-size:0.82rem; text-transform:uppercase; letter-spacing:1.2px; border:none; cursor:pointer; border-radius:6px; transition:all 0.3s ease; margin:6px; text-decoration:none; font-weight:700; white-space:nowrap; }
.btn-gold { background:var(--gold-gradient); color:var(--navy); box-shadow:0 4px 16px rgba(184,149,80,0.35); }
.btn-gold:hover { transform:translateY(-2px); box-shadow:0 8px 28px rgba(184,149,80,0.5); }
.btn-outline { background:transparent; color:var(--navy); border:2px solid var(--gold); }
.btn-outline:hover { background:var(--navy); color:var(--gold-bright); }
.btn-navy { background:var(--navy); color:var(--white); border:2px solid var(--navy); }
.btn-navy:hover { background:transparent; color:var(--navy); }
.btn-white-outline { background:transparent; color:var(--white); border:2px solid var(--white); }
.btn-white-outline:hover { background:var(--white); color:var(--navy); }
.btn-lg { padding:18px 40px; font-size:0.9rem; }

/* Cards */
.card { background:var(--white); border-radius:10px; padding:28px; box-shadow:var(--shadow-soft); border-top:3px solid var(--gold-bright); transition:all 0.3s; }
.card:hover { transform:translateY(-6px); box-shadow:var(--shadow-gold); }
.icon-circle { width:54px; height:54px; background:var(--gold-gradient); border-radius:50%; display:flex; align-items:center; justify-content:center; color:var(--navy); font-size:1.4rem; margin-bottom:16px; box-shadow:0 4px 12px rgba(184,149,80,0.3); }
.status-pill { display:inline-flex; align-items:center; gap:6px; padding:5px 14px; background:var(--gold-pale); color:var(--gold-deep); border-radius:20px; font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; }

/* Forms */
.form-grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
.form-group { display:flex; flex-direction:column; margin-bottom:16px; }
.form-group.full { grid-column:1 / -1; }
.form-label { font-weight:600; margin-bottom:6px; font-size:0.88rem; color:var(--navy); }
.form-label .req { color:var(--red); }
.form-input, .form-select, .form-textarea { padding:12px 16px; border:1.5px solid #d0d4dc; border-radius:6px; font-family:inherit; font-size:0.95rem; transition:all 0.3s; background:var(--white); width:100%; }
.form-input:focus, .form-select:focus, .form-textarea:focus { outline:none; border-color:var(--gold-bright); box-shadow:0 0 0 3px rgba(212,175,55,0.15); }
.form-textarea { min-height:100px; resize:vertical; }
.form-checkbox { display:flex; align-items:flex-start; gap:12px; margin-bottom:14px; padding:14px; background:var(--ivory); border-radius:6px; border:1px solid rgba(184,149,80,0.2); }
.form-checkbox input { margin-top:3px; width:18px; height:18px; accent-color:var(--gold); }
.form-checkbox label { cursor:pointer; font-size:0.9rem; line-height:1.5; }
.file-upload { border:2px dashed var(--gold); padding:32px; text-align:center; border-radius:8px; cursor:pointer; background:rgba(248,246,240,0.5); transition:all 0.3s; }
.file-upload:hover { background:rgba(184,149,80,0.1); border-color:var(--gold-deep); }
.file-upload i { font-size:2.5rem; color:var(--gold); margin-bottom:12px; }

/* Timeline */
.timeline { position:relative; padding-inline-start:40px; margin:32px 0; }
.timeline::before { content:''; position:absolute; top:0; bottom:0; inset-inline-start:0; width:3px; background:linear-gradient(to bottom, var(--green) 0%, var(--gold-bright) 45%, var(--grey) 100%); }
.timeline-item { position:relative; margin-bottom:32px; }
.timeline-dot { position:absolute; inset-inline-start:-49px; top:4px; width:18px; height:18px; border-radius:50%; background:var(--grey); border:3px solid var(--white); box-shadow:0 0 0 2px var(--grey); }
.timeline-dot.done { background:var(--green); box-shadow:0 0 0 2px var(--green); }
.timeline-dot.done::after { content:'✓'; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); color:white; font-size:10px; font-weight:bold; }
.timeline-dot.current { background:var(--gold-bright); box-shadow:0 0 0 2px var(--gold-bright), 0 0 12px var(--gold-bright); }
.timeline-card { background:var(--white); padding:20px 24px; border-radius:8px; border-inline-start:3px solid var(--grey); box-shadow:var(--shadow-soft); }
.timeline-card.done { border-inline-start-color:var(--green); }
.timeline-card.current { border-inline-start-color:var(--gold-bright); }
.timeline-card h4 { margin-bottom:6px; color:var(--navy); }
.timeline-card p { margin:0; font-size:0.9rem; color:var(--grey); }

/* Step Indicator */
.step-indicator { display:flex; align-items:center; justify-content:center; gap:8px; margin-bottom:32px; flex-wrap:wrap; }
.step-node { display:flex; flex-direction:column; align-items:center; gap:8px; flex:1; min-width:100px; }
.step-circle { width:48px; height:48px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:'Cinzel',serif; font-weight:700; font-size:1.1rem; border:3px solid var(--grey); background:var(--white); color:var(--grey); transition:all 0.3s; }
.step-node.active .step-circle { border-color:var(--gold-bright); background:var(--gold-gradient); color:var(--navy); box-shadow:0 0 16px rgba(212,175,55,0.4); }
.step-node.done .step-circle { border-color:var(--green); background:var(--green); color:white; }
.step-node.done .step-circle::after { content:'✓'; }
.step-node.done .step-circle span { display:none; }
.step-label { font-size:0.75rem; font-weight:600; color:var(--grey); text-transform:uppercase; letter-spacing:0.5px; text-align:center; }
.step-node.active .step-label { color:var(--gold-deep); }
.step-node.done .step-label { color:var(--green); }
.step-line { flex:0 0 30px; height:3px; background:var(--grey-light); }
.step-line.done { background:var(--green); }

/* Gallery */
.gallery { position:relative; max-width:900px; margin:0 auto 32px; border:4px solid var(--gold); border-radius:12px; overflow:hidden; box-shadow:var(--shadow-dark); background:var(--navy-deep); }
.gallery-main { width:100%; height:400px; position:relative; overflow:hidden; }
.gallery-slide { position:absolute; top:0; left:0; width:100%; height:100%; opacity:0; transition:opacity 0.6s ease; background-size:cover; background-position:center; }
.gallery-slide.active { opacity:1; }
.gallery-nav { position:absolute; top:50%; transform:translateY(-50%); width:52px; height:52px; border-radius:50%; background:rgba(16,29,53,0.85); border:2px solid var(--gold); color:var(--gold-bright); font-size:1.2rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.3s; z-index:10; }
.gallery-nav:hover { background:var(--gold); color:var(--navy); }
.gallery-prev { inset-inline-start:16px; }
.gallery-next { inset-inline-end:16px; }
.gallery-caption { position:absolute; bottom:0; left:0; width:100%; padding:16px; background:linear-gradient(to top, rgba(0,0,0,0.8), transparent); color:white; text-align:center; font-family:'Cinzel',serif; font-size:1rem; }
.gallery-thumbs { display:flex; gap:8px; padding:12px; background:var(--navy-deep); justify-content:center; }
.gallery-thumb { width:80px; height:50px; border-radius:4px; cursor:pointer; border:2px solid transparent; background-size:cover; background-position:center; transition:all 0.3s; opacity:0.6; }
.gallery-thumb:hover { opacity:1; }
.gallery-thumb.active { border-color:var(--gold-bright); opacity:1; }

/* Recognition Cards */
.recognition-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:20px; margin-top:24px; }
.recognition-card { background:var(--white); border-radius:10px; overflow:hidden; border:1px solid rgba(184,149,80,0.25); box-shadow:var(--shadow-soft); transition:all 0.3s; display:flex; flex-direction:column; }
.recognition-card:hover { transform:translateY(-4px); box-shadow:var(--shadow-gold); }
.recognition-card.featured { grid-column:span 2; border:2px solid var(--gold); }
.recognition-icon-area { height:140px; background:linear-gradient(135deg, var(--navy), var(--navy-darker)); display:flex; align-items:center; justify-content:center; border-bottom:2px solid var(--gold); gap:12px; flex-wrap:wrap; padding:16px; }
.recognition-icon-area i { color:var(--gold-bright); font-size:2.5rem; }
.recognition-icon-area .icon-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.recognition-icon-area .icon-grid i { font-size:1.6rem; }
.recognition-body { padding:20px; flex:1; display:flex; flex-direction:column; }
.recognition-body h4 { color:var(--navy); margin-bottom:8px; font-size:1.05rem; }
.recognition-body p { font-size:0.85rem; color:var(--grey); margin-bottom:14px; flex:1; }
.recognition-amount { font-family:'Cinzel',serif; font-size:2rem; font-weight:700; background:var(--gold-gradient); -webkit-background-clip:text; -webkit-text-fill-color:transparent; margin-bottom:8px; }

/* Countdown */
.countdown-container { display:flex; flex-direction:column; align-items:center; padding:48px 24px; }
.countdown-ring-wrapper { position:relative; width:280px; height:280px; margin-bottom:32px; }
.countdown-ring-svg { width:100%; height:100%; transform:rotate(-90deg); }
.countdown-ring-bg { stroke:rgba(255,255,255,0.1); }
.countdown-ring-progress { stroke:url(#goldGradient); transition:stroke-dashoffset 1s linear; }
.countdown-display { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center; }
.countdown-time { font-family:'Cinzel',serif; font-size:4rem; font-weight:900; color:var(--gold-bright); line-height:1; text-shadow:0 0 20px rgba(212,175,55,0.5); }
.countdown-label { font-size:0.8rem; color:var(--silver); text-transform:uppercase; letter-spacing:2px; margin-top:8px; }
.countdown-complete { display:none; text-align:center; padding:32px; background:rgba(80,123,96,0.15); border:2px solid var(--green); border-radius:12px; margin-bottom:24px; }
.countdown-complete.show { display:block; animation:fadeInUp 0.6s ease; }
.countdown-complete i { font-size:3rem; color:var(--green-light); margin-bottom:16px; }
.countdown-complete h3 { color:var(--green-light); margin-bottom:8px; }

/* Dashboard Stats */
.stats-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:16px; margin-bottom:32px; }
.stat-card { background:var(--white); border-radius:8px; padding:24px; border-top:3px solid var(--gold-bright); box-shadow:var(--shadow-soft); display:flex; align-items:center; gap:16px; }
.stat-card .stat-icon { width:48px; height:48px; border-radius:50%; background:var(--gold-gradient); display:flex; align-items:center; justify-content:center; color:var(--navy); font-size:1.2rem; flex-shrink:0; }
.stat-info h4 { font-size:0.78rem; color:var(--grey); text-transform:uppercase; letter-spacing:1px; margin-bottom:4px; }
.stat-info .stat-value { font-family:'Cinzel',serif; font-size:1.4rem; font-weight:700; color:var(--navy); }

/* Table */
.manifest-table { width:100%; border-collapse:collapse; background:var(--white); border-radius:8px; overflow:hidden; box-shadow:var(--shadow-soft); margin:24px 0; }
.manifest-table thead { background:var(--navy); }
.manifest-table th { padding:14px 16px; text-align:start; color:var(--gold-bright); font-family:'Cinzel',serif; font-size:0.78rem; text-transform:uppercase; letter-spacing:1px; font-weight:600; }
.manifest-table td { padding:14px 16px; border-bottom:1px solid var(--grey-light); font-size:0.9rem; color:var(--navy); }
.manifest-table tbody tr:hover { background:var(--ivory); }
.manifest-table tbody tr:last-child td { border-bottom:none; }

/* Glowing Email */
.email-section { margin-top:48px; padding:64px 24px; text-align:center; background:radial-gradient(circle at center, rgba(212,175,55,0.15) 0%, var(--navy-darker) 70%); border:4px solid transparent; border-image:linear-gradient(45deg, #F7E7B4, #D4AF37, #B89550, #D4AF37, #F7E7B4, #B89550) 1; box-shadow:0 0 32px rgba(212,175,55,0.3); position:relative; overflow:hidden; border-radius:12px; }
.email-halo { position:absolute; top:50%; left:50%; width:400px; height:400px; transform:translate(-50%,-50%); background:conic-gradient(from 0deg, transparent 0deg, rgba(212,175,55,0.2) 90deg, transparent 180deg, rgba(212,175,55,0.2) 270deg, transparent 360deg); animation:rotateHalo 14s linear infinite; z-index:0; pointer-events:none; }
.email-content { position:relative; z-index:1; }
.email-heading { font-family:'Cinzel',serif; color:var(--gold-champagne); font-size:1.4rem; letter-spacing:3px; margin-bottom:16px; text-shadow:0 0 12px rgba(212,175,55,0.6); }
.email-subtitle { color:var(--silver); margin-bottom:32px; }
.email-link { display:inline-flex; align-items:center; gap:12px; font-family:'Inter',sans-serif; font-weight:900; font-size:clamp(1rem, 3vw, 1.8rem); color:var(--gold-bright); text-decoration:none; background:rgba(10,20,36,0.8); padding:18px 36px; border-radius:10px; border:1.5px solid var(--gold); animation:pulse 2.2s infinite; transition:transform 0.3s; word-break:break-all; max-width:100%; }
.email-link:hover { transform:scale(1.02); color:var(--gold-pale); }
.email-link i { font-size:1.4rem; flex-shrink:0; }

/* FAQ */
.faq-item { background:var(--white); border:1px solid rgba(184,149,80,0.2); border-radius:8px; margin-bottom:12px; overflow:hidden; transition:all 0.3s; }
.faq-item.open { border-color:var(--gold-bright); box-shadow:var(--shadow-soft); }
.faq-question { padding:20px 24px; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:16px; font-weight:600; color:var(--navy); font-family:'Cinzel',serif; font-size:0.95rem; transition:background 0.3s; }
.faq-question:hover { background:rgba(184,149,80,0.05); }
.faq-item.open .faq-question { background:rgba(184,149,80,0.08); }
.faq-chevron { color:var(--gold); transition:transform 0.3s; flex-shrink:0; }
.faq-item.open .faq-chevron { transform:rotate(180deg); }
.faq-answer { max-height:0; overflow:hidden; transition:max-height 0.4s ease, padding 0.3s ease; padding:0 24px; color:var(--grey); line-height:1.7; font-size:0.92rem; }
.faq-item.open .faq-answer { max-height:300px; padding:0 24px 20px; }

/* Verification */
.verify-result { margin-top:24px; padding:24px; border-radius:8px; display:none; animation:fadeInUp 0.5s ease forwards; }
.verify-result.show { display:block; }
.verify-result.success { background:rgba(80,123,96,0.1); border:2px solid var(--green); }
.verify-result.pending { background:rgba(212,175,55,0.1); border:2px solid var(--gold-bright); }
.verify-result.error { background:rgba(178,34,52,0.1); border:2px solid var(--red); }
.verify-result i { font-size:2rem; margin-bottom:12px; }
.verify-result.success i { color:var(--green); }
.verify-result.pending i { color:var(--gold-bright); }
.verify-result.error i { color:var(--red); }
.verify-result h3 { margin-bottom:8px; }

/* Footer */
footer { background:var(--navy); color:var(--white); padding:48px 24px 24px; border-top:3px solid var(--gold); position:relative; overflow:hidden; margin-top:64px; }
footer::before { content:''; position:absolute; top:0; left:0; width:100%; height:100%; background:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1235 650"><rect width="1235" height="650" fill="%23fff"/><g fill="%23b22234"><rect width="1235" height="50" y="0"/><rect width="1235" height="50" y="100"/><rect width="1235" height="50" y="200"/><rect width="1235" height="50" y="300"/><rect width="1235" height="50" y="400"/><rect width="1235" height="50" y="500"/><rect width="1235" height="50" y="600"/></g><rect width="494" height="350" fill="%233c3b6e"/></svg>'); opacity:0.05; pointer-events:none; }
footer > * { position:relative; z-index:1; }
.footer-content { max-width:1440px; margin:0 auto; text-align:center; }
.footer-crest { font-family:'Cinzel',serif; color:var(--gold-bright); font-size:1.1rem; letter-spacing:3px; margin-bottom:8px; }
.footer-nav { display:flex; justify-content:center; flex-wrap:wrap; gap:8px 20px; margin:20px 0; }
.footer-nav a { color:var(--gold-champagne); text-decoration:none; font-size:0.82rem; cursor:pointer; }
.footer-nav a:hover { text-decoration:underline; }
.footer-bottom { font-size:0.75rem; color:var(--grey); margin-top:16px; }

/* Responsive */
@media (max-width: 1024px) {
  .nav-link { font-size:0.68rem; padding:6px 10px; }
  .recognition-card.featured { grid-column:span 1; }
}
@media (max-width: 860px) {
  .nav-links { display:none; position:absolute; top:100%; left:0; width:100%; background:var(--ivory); flex-direction:column; padding:16px; box-shadow:var(--shadow-dark); border-top:2px solid var(--gold); gap:4px; }
  .nav-links.show { display:flex; }
  .nav-link { padding:12px 16px; width:100%; border-radius:6px; font-size:0.8rem; }
  .mobile-toggle { display:block; }
  .brand-text { display:none; }
  main { padding-top:120px; padding-inline:16px; }
  .panel { padding:24px; }
  .form-grid-2 { grid-template-columns:1fr; }
  .gallery-main { height:250px; }
  .gallery-thumb { width:60px; height:40px; }
  .stats-grid { grid-template-columns:1fr 1fr; }
  .countdown-ring-wrapper { width:220px; height:220px; }
  .countdown-time { font-size:3rem; }
  .step-indicator { gap:4px; }
  .step-node { min-width:60px; }
  .step-circle { width:36px; height:36px; font-size:0.9rem; }
  .step-label { font-size:0.65rem; }
  .step-line { flex:0 0 16px; }
  .manifest-table { font-size:0.78rem; }
  .manifest-table th, .manifest-table td { padding:10px 8px; }
}
@media (max-width: 480px) {
  .stats-grid { grid-template-columns:1fr; }
  .gallery-main { height:200px; }
  .recognition-grid { grid-template-columns:1fr; }
  .btn { padding:12px 20px; font-size:0.75rem; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; }
}
</style>
</head>
<body class="ltr">

<div class="flag-bg"></div>
<div class="flag-overlay"></div>

<header>
  <div class="nav-container">
    <div class="nav-top">
      <div class="brand" onclick="navigate('home')">
        <div class="medal-emblem">
          <svg viewBox="0 0 100 100">
            <defs>
              <linearGradient id="ribbonGrad" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" style="stop-color:#172B4D"/><stop offset="100%" style="stop-color:#0A1424"/></linearGradient>
              <radialGradient id="medalGrad" cx="50%" cy="40%" r="60%"><stop offset="0%" style="stop-color:#F7E7B4"/><stop offset="50%" style="stop-color:#D4AF37"/><stop offset="100%" style="stop-color:#8B6F2C"/></radialGradient>
            </defs>
            <path d="M 35,5 L 50,35 L 65,5 L 60,5 L 50,22 L 40,5 Z" fill="url(#ribbonGrad)"/>
            <circle cx="50" cy="55" r="32" fill="url(#medalGrad)" stroke="#8B6F2C" stroke-width="1"/>
            <circle cx="50" cy="55" r="26" fill="none" stroke="#8B6F2C" stroke-width="0.5" opacity="0.6"/>
            <path d="M 50,38 L 53,48 L 63,48 L 55,54 L 58,64 L 50,58 L 42,64 L 45,54 L 37,48 L 47,48 Z" fill="#172B4D" opacity="0.9"/>
          </svg>
        </div>
        <div class="brand-text" data-en="WOUNDED MILITARY HEROES" data-he="גיבורים צבאים פצועים">WOUNDED MILITARY HEROES</div>
      </div>
      <div class="nav-right">
        <div class="lang-selector">
          <button class="lang-btn active" data-lang="en" onclick="setLanguage('en')">🇺🇸 EN</button>
          <button class="lang-btn" data-lang="he" onclick="setLanguage('he')">🇮🇱 עב</button>
        </div>
        <button class="mobile-toggle" onclick="toggleMenu()"><i class="fas fa-bars"></i></button>
      </div>
    </div>
    <nav class="nav-links" id="navLinks">
      <div class="nav-link active" onclick="navigate('home')" data-en="Home" data-he="דף הבית">Home</div>
      <div class="nav-link" onclick="navigate('about')" data-en="About" data-he="אודות">About</div>
      <div class="nav-link" onclick="navigate('recognition')" data-en="Recognition" data-he="הוקרה">Recognition</div>
      <div class="nav-link" onclick="navigate('soldier')" data-en="Soldier's Voice" data-he="קול החיילת">Soldier's Voice</div>
      <div class="nav-link" onclick="navigate('application')" data-en="Apply" data-he="הגשת בקשה">Apply</div>
      <div class="nav-link" onclick="navigate('dashboard')" data-en="Dashboard" data-he="לוח בקרה">Dashboard</div>
      <div class="nav-link" onclick="navigate('delivery')" data-en="Delivery" data-he="משלוחים">Delivery</div>
      <div class="nav-link" onclick="navigate('verification')" data-en="Verification" data-he="אימות">Verification</div>
      <div class="nav-link" onclick="navigate('resources')" data-en="Resources" data-he="משאבים">Resources</div>
    </nav>
  </div>
</header>

<main>
  <!-- PAGE 1: HOME -->
  <div id="page-home" class="page active">
    <div class="panel dark-panel" style="text-align:center; padding:64px 40px;">
      <div style="width:120px; height:120px; margin:0 auto 24px; animation:floatMedal 5s ease-in-out infinite;">
        <svg viewBox="0 0 100 100" style="width:100%; height:100%;">
          <defs><radialGradient id="heroMedalGrad" cx="50%" cy="40%" r="60%"><stop offset="0%" style="stop-color:#F7E7B4"/><stop offset="50%" style="stop-color:#D4AF37"/><stop offset="100%" style="stop-color:#8B6F2C"/></radialGradient></defs>
          <path d="M 30,2 L 50,32 L 70,2 L 62,2 L 50,18 L 38,2 Z" fill="#172B4D"/>
          <circle cx="50" cy="55" r="35" fill="url(#heroMedalGrad)" stroke="#8B6F2C" stroke-width="1.5"/>
          <circle cx="50" cy="55" r="28" fill="none" stroke="#8B6F2C" stroke-width="0.8" opacity="0.5"/>
          <path d="M 50,36 L 54,48 L 66,48 L 56,56 L 60,68 L 50,60 L 40,68 L 44,56 L 34,48 L 46,48 Z" fill="#172B4D"/>
        </svg>
      </div>
      <h1 style="color:white;" data-en="WOUNDED <span class='gold-text'>MILITARY HEROES</span>" data-he="גיבורים <span class='gold-text'>צבאים פצועים</span>">WOUNDED <span class="gold-text">MILITARY HEROES</span></h1>
      <p class="italic-serif" style="color:var(--gold-champagne); font-size:1.3rem; margin-bottom:24px;" data-en="Honoring Courage. Recognizing Sacrifice. Supporting Recovery." data-he="מכבדים גבורה. מכירים בהקרבה. תומכים בהחלמה.">Honoring Courage. Recognizing Sacrifice. Supporting Recovery.</p>
      <p style="color:#ccc; max-width:800px; margin:0 auto 32px;" data-en="A respectful digital space dedicated to providing information, administrative guidance and proposed recognition opportunities for wounded female military personnel and their families." data-he="מרחב דיגיטלי מכבד המוקדש למתן מידע, הדרכה מנהלית והזדמנויות הוקרה מוצעות עבור חיילות פצועות ומשפחותיהן.">A respectful digital space dedicated to providing information, administrative guidance and proposed recognition opportunities for wounded female military personnel and their families.</p>
      <div style="display:flex; justify-content:center; flex-wrap:wrap; gap:8px;">
        <button class="btn btn-gold" onclick="navigate('about')" data-en="Explore the Programme" data-he="גלו את התכנית">Explore the Programme</button>
        <button class="btn btn-white-outline" onclick="navigate('application')" data-en="Family Representative Application" data-he="הגשת בקשה כנציג משפחה">Family Representative Application</button>
      </div>
    </div>
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:20px; margin-top:32px;">
      <div class="card"><div class="icon-circle"><i class="fas fa-hands-helping"></i></div><h3 data-en="Dignified Care" data-he="טיפול מכבד">Dignified Care</h3><p data-en="Compassionate support and respect for wounded service members." data-he="תמיכה וכבוד חומלים לחיילים פצועים.">Compassionate support and respect for wounded service members.</p></div>
      <div class="card"><div class="icon-circle"><i class="fas fa-users"></i></div><h3 data-en="Family Representation" data-he="ייצוג משפחתי">Family Representation</h3><p data-en="Assistance from authorized family representatives." data-he="סיוע מנציגי משפחה מורשים.">Assistance from authorized family representatives.</p></div>
      <div class="card"><div class="icon-circle"><i class="fas fa-shield-alt"></i></div><h3 data-en="Transparent Administration" data-he="מנהל שקוף">Transparent Administration</h3><p data-en="Clear processes and honest communication." data-he="תהליכים ברורים ותקשורת כנה.">Clear processes and honest communication.</p></div>
      <div class="card"><div class="icon-circle"><i class="fas fa-award"></i></div><h3 data-en="Recognition & Appreciation" data-he="הוקרה והערכה">Recognition & Appreciation</h3><p data-en="Honoring service through proposed recognition opportunities." data-he="כיבוד שירות באמצעות הזדמנויות הוקרה מוצעות.">Honoring service through proposed recognition opportunities.</p></div>
      <div class="card"><div class="icon-circle"><i class="fas fa-heart"></i></div><h3 data-en="Wellness & Recovery" data-he="רווחה והחלמה">Wellness & Recovery</h3><p data-en="Long-term rehabilitation and wellness support." data-he="תמיכה ארוכת טווח בשיקום ורווחה.">Long-term rehabilitation and wellness support.</p></div>
    </div>
  </div>

  <!-- PAGE 2: ABOUT -->
  <div id="page-about" class="page">
    <div class="panel">
      <div class="eyebrow" data-en="Programme Overview" data-he="סקירת התכנית">Programme Overview</div>
      <h2 data-en="Understanding the <span class='gold-text'>Programme</span>" data-he="הבנת <span class='gold-text'>התכנית</span>">Understanding the <span class="gold-text">Programme</span></h2>
      <p data-en="The recognition programme follows a structured seven-stage process, from initial enquiry to ongoing wellness support. Each stage is designed to ensure transparency, dignity, and proper verification." data-he="תכנית ההוקרה עוקבת אחר תהליך מובנה בן שבעה שלבים, מפנייה ראשונית ועד תמיכה שוטפת ברווחה. כל שלב נועד להבטיח שקיפות, כבוד ואימות נאות.">The recognition programme follows a structured seven-stage process, from initial enquiry to ongoing wellness support. Each stage is designed to ensure transparency, dignity, and proper verification.</p>
      <div class="timeline">
        <div class="timeline-item"><div class="timeline-dot done"></div><div class="timeline-card done"><h4 data-en="1. Initial Representative Enquiry" data-he="1. פנייה ראשונית של נציג">1. Initial Representative Enquiry</h4><p data-en="A family representative expresses interest in assisting the wounded soldier." data-he="נציג משפחה מביע עניין בסיוע לחיילת הפצועה.">A family representative expresses interest in assisting the wounded soldier.</p></div></div>
        <div class="timeline-item"><div class="timeline-dot done"></div><div class="timeline-card done"><h4 data-en="2. Eligibility & Identity Review" data-he="2. סקירת זכאות וזהות">2. Eligibility & Identity Review</h4><p data-en="The identities and authorization of the representative and soldier are verified." data-he="זהות והרשאת הנציג והחיילת מאומתות.">The identities and authorization of the representative and soldier are verified.</p></div></div>
        <div class="timeline-item"><div class="timeline-dot done"></div><div class="timeline-card done"><h4 data-en="3. Documentation Assessment" data-he="3. הערכת מסמכים">3. Documentation Assessment</h4><p data-en="Required application documents are reviewed by programme administrators." data-he="מסמכי הבקשה הנדרשים נסקרים על ידי מנהלי התכנית.">Required application documents are reviewed by programme administrators.</p></div></div>
        <div class="timeline-item"><div class="timeline-dot current"></div><div class="timeline-card current"><h4 data-en="4. Administrative Verification" data-he="4. אימות מנהלי">4. Administrative Verification</h4><p data-en="The responsible organization evaluates the application against its requirements." data-he="הארגון האחראי מעריך את הבקשה מול דרישותיו.">The responsible organization evaluates the application against its requirements.</p></div></div>
        <div class="timeline-item"><div class="timeline-dot"></div><div class="timeline-card"><h4 data-en="5. Recognition Review" data-he="5. סקירת הוקרה">5. Recognition Review</h4><p data-en="Proposed recognition opportunities are reviewed and assessed." data-he="הזדמנויות הוקרה מוצעות נסקרות ומוערכות.">Proposed recognition opportunities are reviewed and assessed.</p></div></div>
        <div class="timeline-item"><div class="timeline-dot"></div><div class="timeline-card"><h4 data-en="6. Delivery Planning" data-he="6. תכנון משלוח">6. Delivery Planning</h4><p data-en="Arrangements for approved recognition items are coordinated." data-he="מתואמים סידורים לפריטי הוקרה מאושרים.">Arrangements for approved recognition items are coordinated.</p></div></div>
        <div class="timeline-item"><div class="timeline-dot"></div><div class="timeline-card"><h4 data-en="7. Ongoing Wellness & Follow-up" data-he="7. רווחה שוטפת ומעקב">7. Ongoing Wellness & Follow-up</h4><p data-en="Recovery support and follow-up information are provided where applicable." data-he="מידע על תמיכה בהחלמה ומעקב מסופק במידת הצורך.">Recovery support and follow-up information are provided where applicable.</p></div></div>
      </div>
    </div>
    <div class="text-center">
      <button class="btn btn-outline" onclick="navigate('home')" data-en="Back to Home" data-he="חזרה לדף הבית">Back to Home</button>
      <button class="btn btn-gold" onclick="navigate('recognition')" data-en="View Recognition Package" data-he="צפו בחבילת ההוקרה">View Recognition Package</button>
    </div>
  </div>

  <!-- PAGE 3: RECOGNITION -->
  <div id="page-recognition" class="page">
    <div class="panel dark-panel" style="text-align:center; padding:40px;">
      <div class="eyebrow" style="color:var(--gold-champagne);" data-en="Recognition Package" data-he="חבילת הוקרה">Recognition Package</div>
      <h2 style="color:white;" data-en="THE PROPOSED <span class='gold-text'>RECOGNITION PACKAGE</span>" data-he="חבילת <span class='gold-text'>ההוקרה המוצעת</span>">THE PROPOSED <span class="gold-text">RECOGNITION PACKAGE</span></h2>
      <p style="color:#ccc; max-width:700px; margin:0 auto;" data-en="The following items are proposed recognition opportunities. All items remain proposed until independently confirmed." data-he="הפריטים הבאים הם הזדמנויות הוקרה מוצעות. כל הפריטים נשארים מוצעים עד לאישור עצמאי.">The following items are proposed recognition opportunities. All items remain proposed until independently confirmed.</p>
    </div>

    <div class="gallery" id="teslaGallery">
      <div class="gallery-main">
        <div class="gallery-slide active" style="background-image:url('https://images.unsplash.com/photo-1560958089-b8a1929cea89?w=1200&q=80');" data-caption="Front Exterior View"></div>
        <div class="gallery-slide" style="background-image:url('https://images.unsplash.com/photo-1617788138017-80ad40651399?w=1200&q=80');" data-caption="Side Profile View"></div>
        <div class="gallery-slide" style="background-image:url('https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?w=1200&q=80');" data-caption="Interior View"></div>
        <button class="gallery-nav gallery-prev" onclick="changeSlide(-1)"><i class="fas fa-chevron-left"></i></button>
        <button class="gallery-nav gallery-next" onclick="changeSlide(1)"><i class="fas fa-chevron-right"></i></button>
        <div class="gallery-caption" id="galleryCaption">Front Exterior View</div>
      </div>
      <div class="gallery-thumbs">
        <div class="gallery-thumb active" style="background-image:url('https://images.unsplash.com/photo-1560958089-b8a1929cea89?w=200&q=80');" onclick="setSlide(0)"></div>
        <div class="gallery-thumb" style="background-image:url('https://images.unsplash.com/photo-1617788138017-80ad40651399?w=200&q=80');" onclick="setSlide(1)"></div>
        <div class="gallery-thumb" style="background-image:url('https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?w=200&q=80');" onclick="setSlide(2)"></div>
      </div>
    </div>

    <div class="recognition-grid">
      <div class="recognition-card featured">
        <div class="recognition-icon-area"><i class="fas fa-money-bill-wave"></i></div>
        <div class="recognition-body">
          <div class="recognition-amount">$120,000 USD</div>
          <h4 data-en="Proposed Financial Recognition" data-he="הכרה כספית מוצעת">Proposed Financial Recognition</h4>
          <p data-en="A proposed financial recognition benefit to support recovery, rehabilitation, and long-term stability." data-he="הטבת הכרה כספית מוצעת לתמיכה בהחלמה, שיקום ויציבות ארוכת טווח.">A proposed financial recognition benefit to support recovery, rehabilitation, and long-term stability.</p>
          <span class="status-pill"><i class="far fa-clock"></i> <span data-en="PROPOSED — NOT YET APPROVED" data-he="מוצע — טרם אושר">PROPOSED — NOT YET APPROVED</span></span>
        </div>
      </div>
      <div class="recognition-card"><div class="recognition-icon-area"><i class="fas fa-car"></i></div><div class="recognition-body"><h4 data-en="Tesla Vehicle" data-he="רכב טסלה">Tesla Vehicle</h4><p data-en="A proposed vehicle to support mobility and independence." data-he="רכב מוצע לתמיכה בניידות ועצמאות.">A proposed vehicle to support mobility and independence.</p><span class="status-pill"><i class="far fa-clock"></i> <span data-en="PROPOSED" data-he="מוצע">PROPOSED</span></span></div></div>
      <div class="recognition-card"><div class="recognition-icon-area"><i class="fas fa-home"></i></div><div class="recognition-body"><h4 data-en="Housing Support" data-he="תמיכה בדיור">Housing Support</h4><p data-en="A proposed housing support benefit." data-he="הטבת תמיכה בדיור מוצעת.">A proposed housing support benefit.</p><span class="status-pill"><i class="far fa-clock"></i> <span data-en="PROPOSED" data-he="מוצע">PROPOSED</span></span></div></div>
      <div class="recognition-card"><div class="recognition-icon-area"><div class="icon-grid"><i class="fas fa-couch"></i><i class="fas fa-bed"></i><i class="fas fa-table"></i><i class="fas fa-snowflake"></i><i class="fas fa-washing-machine"></i><i class="fas fa-tv"></i></div></div><div class="recognition-body"><h4 data-en="Essential Home Furnishings" data-he="ריהוט ביתי חיוני">Essential Home Furnishings</h4><p data-en="Sofa, bed, dining table, refrigerator, washing machine, TV, kitchen essentials." data-he="ספה, מיטה, שולחן אוכל, מקרר, מכונת כביסה, טלוויזיה, כלי מטבח.">Sofa, bed, dining table, refrigerator, washing machine, TV, kitchen essentials.</p><span class="status-pill"><i class="far fa-clock"></i> <span data-en="PROPOSED" data-he="מוצע">PROPOSED</span></span></div></div>
      <div class="recognition-card"><div class="recognition-icon-area"><i class="fas fa-mobile-alt"></i></div><div class="recognition-body"><h4>iPhone</h4><p data-en="A proposed communication device." data-he="מכשיר תקשורת מוצע.">A proposed communication device.</p><span class="status-pill"><i class="far fa-clock"></i> <span data-en="PROPOSED" data-he="מוצע">PROPOSED</span></span></div></div>
      <div class="recognition-card"><div class="recognition-icon-area"><i class="fas fa-medal"></i></div><div class="recognition-body"><h4 data-en="Gold Military Recognition Medal" data-he="מדליית הוקרה צבאית זהב">Gold Military Recognition Medal</h4><p data-en="A symbolic medal of honour." data-he="מדליית כבוד סמלית.">A symbolic medal of honour.</p><span class="status-pill"><i class="far fa-clock"></i> <span data-en="PROPOSED" data-he="מוצע">PROPOSED</span></span></div></div>
      <div class="recognition-card"><div class="recognition-icon-area"><i class="fas fa-blender"></i></div><div class="recognition-body"><h4 data-en="Home Appliances" data-he="מכשירי חשמל">Home Appliances</h4><p data-en="Essential home appliances." data-he="מכשירי חשמל חיוניים.">Essential home appliances.</p><span class="status-pill"><i class="far fa-clock"></i> <span data-en="PROPOSED" data-he="מוצע">PROPOSED</span></span></div></div>
      <div class="recognition-card"><div class="recognition-icon-area"><i class="fas fa-spa"></i></div><div class="recognition-body"><h4 data-en="Personal Wellness Support" data-he="תמיכה ברווחה אישית">Personal Wellness Support</h4><p data-en="Wellness-inspired support." data-he="תמיכה מושרית רווחה.">Wellness-inspired support.</p><span class="status-pill"><i class="far fa-clock"></i> <span data-en="PROPOSED" data-he="מוצע">PROPOSED</span></span></div></div>
      <div class="recognition-card"><div class="recognition-icon-area"><i class="fas fa-medkit"></i></div><div class="recognition-body"><h4 data-en="Recovery & Rehabilitation Support" data-he="תמיכה בהחלמה ושיקום">Recovery & Rehabilitation Support</h4><p data-en="Medical support and rehabilitation materials." data-he="תמיכה רפואית וחומרי שיקום.">Medical support and rehabilitation materials.</p><span class="status-pill"><i class="far fa-clock"></i> <span data-en="PROPOSED" data-he="מוצע">PROPOSED</span></span></div></div>
      <div class="recognition-card"><div class="recognition-icon-area"><i class="fas fa-house-user"></i></div><div class="recognition-body"><h4 data-en="Long-Term Family Support" data-he="תמיכה משפחתית ארוכת טווח">Long-Term Family Support</h4><p data-en="Ongoing family support resources." data-he="משאבי תמיכה משפחתיים שוטפים.">Ongoing family support resources.</p><span class="status-pill"><i class="far fa-clock"></i> <span data-en="PROPOSED" data-he="מוצע">PROPOSED</span></span></div></div>
    </div>
    <div class="text-center" style="margin-top:32px;">
      <button class="btn btn-outline" onclick="navigate('about')" data-en="Back to About" data-he="חזרה לאודות">Back to About</button>
      <button class="btn btn-navy" onclick="navigate('application')" data-en="Begin Application" data-he="התחלת בקשה">Begin Application</button>
    </div>
  </div>

  <!-- PAGE 4: SOLDIER'S VOICE -->
  <div id="page-soldier" class="page">
    <div class="panel" style="position:relative; overflow:hidden;">
      <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:300px; height:300px; opacity:0.05; pointer-events:none;">
        <svg viewBox="0 0 100 100" style="width:100%; height:100%;"><circle cx="50" cy="50" r="40" fill="#B89550"/><circle cx="50" cy="50" r="32" fill="none" stroke="#8B6F2C" stroke-width="1"/><path d="M 50,32 L 54,44 L 66,44 L 56,52 L 60,64 L 50,56 L 40,64 L 44,52 L 34,44 L 46,44 Z" fill="#172B4D"/></svg>
      </div>
      <div class="eyebrow" data-en="Soldier's Voice" data-he="קול החיילת">Soldier's Voice</div>
      <h2 data-en="A <span class='gold-text'>Soldier's</span> Voice" data-he="קול <span class='gold-text'>החיילת</span>">A <span class="gold-text">Soldier's</span> Voice</h2>
      <div style="border:2px solid var(--gold); padding:40px; border-radius:8px; background:rgba(255,255,255,0.95); position:relative; box-shadow:var(--shadow-soft);">
        <i class="fas fa-feather" style="color:var(--gold); font-size:2rem; margin-bottom:20px;"></i>
        <h3 style="margin-bottom:24px;" data-en="A Letter from the Frontline of Recovery" data-he="מכתב מקו החזית של ההחלמה">A Letter from the Frontline of Recovery</h3>
        <blockquote class="italic-serif" style="font-size:1.15rem; line-height:1.9; color:var(--navy); margin-bottom:24px;" data-en="To everyone who has taken the time to understand my journey,<br><br>My military service has been an important part of my life. My injuries have made certain activities difficult, and there are times when I need assistance from my family.<br><br>I am grateful for the people who continue to stand beside me during my recovery.<br><br>Where I am unable to manage administrative matters personally, I wish to authorize my husband or another trusted family representative to assist with my application and communicate with the relevant programme administrators.<br><br>My hope is that wounded service members are treated with dignity, compassion, and respect.<br><br>Thank you for recognizing the courage of those who have served." data-he="לכל מי שטרח להבין את המסע שלי,<br><br>השירות הצבאי שלי היה חלק חשוב בחיי. הפציעות שלי הקשו על פעילויות מסוימות, וישנם זמנים שבהם אני זקוקה לסיוע ממשפחתי.<br><br>אני אסירת תודה לאנשים שממשיכים לעמוד לצידי במהלך ההחלמה.<br><br>במקרים שבהם איני מסוגלת לנהל עניינים מנהליים באופן אישי, ברצוני לאשר את בעלי או נציג משפחה מהימן אחר לסייע בבקשה שלי ולתקשר עם מנהלי התכנית הרלוונטיים.<br><br>תקוותי היא שחיילים פצועים יזכו ליחס של כבוד, חמלה והערכה.<br><br>תודה לכם על הכרת האומץ של אלו ששירתו.">To everyone who has taken the time to understand my journey,<br><br>My military service has been an important part of my life. My injuries have made certain activities difficult, and there are times when I need assistance from my family.<br><br>I am grateful for the people who continue to stand beside me during my recovery.<br><br>Where I am unable to manage administrative matters personally, I wish to authorize my husband or another trusted family representative to assist with my application and communicate with the relevant programme administrators.<br><br>My hope is that wounded service members are treated with dignity, compassion, and respect.<br><br>Thank you for recognizing the courage of those who have served.</blockquote>
        <p class="signature" style="text-align:end; font-weight:600; font-style:italic; color:var(--navy);" data-en="— With gratitude, A Wounded Service Member" data-he="— בתודה, חיילת פצועה">— With gratitude, A Wounded Service Member</p>
      </div>
    </div>
    <div class="text-center">
      <button class="btn btn-outline" onclick="navigate('recognition')" data-en="Back to Recognition" data-he="חזרה להוקרה">Back to Recognition</button>
      <button class="btn btn-gold" onclick="navigate('application')" data-en="Apply as Representative" data-he="הגשת בקשה כנציג">Apply as Representative</button>
    </div>
  </div>

  <!-- PAGE 5: APPLICATION -->
  <div id="page-application" class="page">
    <div class="panel">
      <div class="eyebrow" data-en="Family Representative Application" data-he="בקשת נציג משפחה">Family Representative Application</div>
      <h2 data-en="Application & <span class='gold-text'>Registration Portal</span>" data-he="פורטל <span class='gold-text'>בקשות והרשמה</span>">Application & <span class="gold-text">Registration Portal</span></h2>
      
      <div class="step-indicator" id="stepIndicator">
        <div class="step-node active" data-step="1"><div class="step-circle"><span>1</span></div><div class="step-label" data-en="Representative" data-he="נציג">Representative</div></div>
        <div class="step-line"></div>
        <div class="step-node" data-step="2"><div class="step-circle"><span>2</span></div><div class="step-label" data-en="Soldier Info" data-he="פרטי חיילת">Soldier Info</div></div>
        <div class="step-line"></div>
        <div class="step-node" data-step="3"><div class="step-circle"><span>3</span></div><div class="step-label" data-en="Review" data-he="סקירה">Review</div></div>
        <div class="step-line"></div>
        <div class="step-node" data-step="4"><div class="step-circle"><span>4</span></div><div class="step-label" data-en="Status" data-he="סטטוס">Status</div></div>
      </div>

      <!-- Step 1 -->
      <div id="formStep1" class="form-step active">
        <h3 data-en="Step 1: Representative Information" data-he="שלב 1: פרטי הנציג">Step 1: Representative Information</h3>
        <div class="form-grid-2" style="margin-top:20px;">
          <div class="form-group full"><label class="form-label" data-en="Full Legal Name <span class='req'>*</span>" data-he="שם מלא חוקי <span class='req'>*</span>">Full Legal Name <span class="req">*</span></label><input type="text" class="form-input" id="repName" data-en-ph="Enter your full legal name" data-he-ph="הכנס את שמך המלא החוקי"></div>
          <div class="form-group"><label class="form-label" data-en="Relationship to Soldier <span class='req'>*</span>" data-he="קרבה לחיילת <span class='req'>*</span>">Relationship to Soldier <span class="req">*</span></label><select class="form-select" id="repRelationship"><option data-en="Select..." data-he="בחר...">Select...</option><option data-en="Husband" data-he="בעל">Husband</option><option data-en="Wife" data-he="אישה">Wife</option><option data-en="Parent" data-he="הורה">Parent</option><option data-en="Sibling" data-he="אח/ות">Sibling</option><option data-en="Legal Guardian" data-he="אפוטרופוס חוקי">Legal Guardian</option></select></div>
          <div class="form-group"><label class="form-label" data-en="Email Address <span class='req'>*</span>" data-he="כתובת דוא״ל <span class='req'>*</span>">Email Address <span class="req">*</span></label><input type="email" class="form-input" id="repEmail" data-en-ph="email@example.com" data-he-ph="דוא״ל@דוגמה.קום"></div>
          <div class="form-group"><label class="form-label" data-en="Telephone Number <span class='req'>*</span>" data-he="מספר טלפון <span class='req'>*</span>">Telephone Number <span class="req">*</span></label><input type="tel" class="form-input" id="repPhone" data-en-ph="+1 (555) 000-0000" data-he-ph="+972 50 000 0000"></div>
          <div class="form-group"><label class="form-label" data-en="Country of Residence <span class='req'>*</span>" data-he="מדינת מגורים <span class='req'>*</span>">Country of Residence <span class="req">*</span></label><select class="form-select" id="repCountry"><option data-en="Select..." data-he="בחר...">Select...</option><option data-en="United States" data-he="ארצות הברית">United States</option><option data-en="United Kingdom" data-he="הממלכה המאוחדת">United Kingdom</option><option data-en="Canada" data-he="קנדה">Canada</option><option data-en="Australia" data-he="אוסטרליה">Australia</option><option data-en="Israel" data-he="ישראל">Israel</option><option data-en="Other" data-he="אחר">Other</option></select></div>
        </div>
        <div class="text-center" style="margin-top:24px;"><button class="btn btn-gold" onclick="goToStep(2)" data-en="Continue to Soldier Details" data-he="המשך לפרטי החיילת">Continue to Soldier Details</button></div>
      </div>

      <!-- Step 2 -->
      <div id="formStep2" class="form-step" style="display:none;">
        <h3 data-en="Step 2: Soldier Information" data-he="שלב 2: פרטי החיילת">Step 2: Soldier Information</h3>
        <div class="form-grid-2" style="margin-top:20px;">
          <div class="form-group"><label class="form-label" data-en="Soldier's Full Name <span class='req'>*</span>" data-he="שם מלא של החיילת <span class='req'>*</span>">Soldier's Full Name <span class="req">*</span></label><input type="text" class="form-input" id="soldierName" data-en-ph="Soldier's full name" data-he-ph="שם מלא של החיילת"></div>
          <div class="form-group"><label class="form-label" data-en="Military Service Number <span class='req'>*</span>" data-he="מספר שירות צבאי <span class='req'>*</span>">Military Service Number <span class="req">*</span></label><input type="text" class="form-input" id="soldierService" data-en-ph="Service number" data-he-ph="מספר שירות"></div>
          <div class="form-group"><label class="form-label" data-en="Branch of Service <span class='req'>*</span>" data-he="ענף שירות <span class='req'>*</span>">Branch of Service <span class="req">*</span></label><select class="form-select" id="soldierBranch"><option data-en="Select..." data-he="בחר...">Select...</option><option data-en="Army" data-he="צבא היבשה">Army</option><option data-en="Navy" data-he="חיל הים">Navy</option><option data-en="Air Force" data-he="חיל האוויר">Air Force</option><option data-en="Marines" data-he="חיל הנחתים">Marines</option></select></div>
          <div class="form-group"><label class="form-label" data-en="Country of Service <span class='req'>*</span>" data-he="מדינת שירות <span class='req'>*</span>">Country of Service <span class="req">*</span></label><select class="form-select" id="soldierCountry"><option data-en="Select..." data-he="בחר...">Select...</option><option data-en="United States" data-he="ארצות הברית">United States</option><option data-en="Israel" data-he="ישראל">Israel</option><option data-en="Other" data-he="אחר">Other</option></select></div>
          <div class="form-group full"><label class="form-label" data-en="Supporting Authorization Documents <span class='req'>*</span>" data-he="מסמכי הרשאה תומכים <span class='req'>*</span>">Supporting Authorization Documents <span class="req">*</span></label><div class="file-upload" onclick="document.getElementById('fileInput').click()"><i class="fas fa-cloud-upload-alt"></i><p data-en="Click to upload or drag a file here" data-he="לחץ להעלות או גרור קובץ לכאן">Click to upload or drag a file here</p><p class="muted" style="font-size:0.8rem;" data-en="PDF, JPG, PNG — max 10MB" data-he="PDF, JPG, PNG — עד 10MB">PDF, JPG, PNG — max 10MB</p><input type="file" id="fileInput" style="display:none;" onchange="document.getElementById('fileName').textContent = this.files[0] ? this.files[0].name : '';"><p id="fileName" style="margin-top:8px; color:var(--green); font-weight:600;"></p></div></div>
        </div>
        <div class="text-center" style="margin-top:24px;"><button class="btn btn-outline" onclick="goToStep(1)" data-en="Back" data-he="חזור">Back</button><button class="btn btn-gold" onclick="goToStep(3)" data-en="Review Application" data-he="סקירת הבקשה">Review Application</button></div>
      </div>

      <!-- Step 3 -->
      <div id="formStep3" class="form-step" style="display:none;">
        <h3 data-en="Step 3: Review Information" data-he="שלב 3: סקירת מידע">Step 3: Review Information</h3>
        <div style="background:var(--ivory); padding:24px; border-radius:8px; margin-top:20px;" id="reviewPanel"><p style="color:var(--grey); text-align:center;" data-en="Please complete Steps 1 and 2 to review your information." data-he="נא להשלים את שלבים 1 ו-2 כדי לסקור את המידע שלך.">Please complete Steps 1 and 2 to review your information.</p></div>
        <div class="form-checkbox" style="margin-top:24px;"><input type="checkbox" id="privacyAck"><label for="privacyAck" data-en="I acknowledge the privacy policy and confirm that the information provided is accurate and complete." data-he="אני מאשר/ת את מדיניות הפרטיות ומאשר/ת שהמידע שסופק מדויק ומלא.">I acknowledge the privacy policy and confirm that the information provided is accurate and complete.</label></div>
        <div class="text-center" style="margin-top:24px;"><button class="btn btn-outline" onclick="goToStep(2)" data-en="Back" data-he="חזור">Back</button><button class="btn btn-gold" onclick="submitApplication()" data-en="Submit Application" data-he="שלח בקשה">Submit Application</button></div>
      </div>

      <!-- Step 4: Countdown -->
      <div id="formStep4" class="form-step" style="display:none;">
        <div class="countdown-container">
          <div class="eyebrow" style="color:var(--gold-champagne);" data-en="Application Received" data-he="הבקשה התקבלה">Application Received</div>
          <h3 style="color:white; margin-bottom:8px;" data-en="Your Administrative Waiting Period" data-he="תקופת ההמתנה המנהלית שלך">Your Administrative Waiting Period</h3>
          <div class="countdown-ring-wrapper">
            <svg class="countdown-ring-svg" viewBox="0 0 200 200">
              <defs><linearGradient id="goldGradient" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#F7E7B4"/><stop offset="50%" style="stop-color:#D4AF37"/><stop offset="100%" style="stop-color:#B89550"/></linearGradient></defs>
              <circle class="countdown-ring-bg" cx="100" cy="100" r="90" fill="none" stroke-width="8"/>
              <circle class="countdown-ring-progress" id="countdownRing" cx="100" cy="100" r="90" fill="none" stroke-width="8" stroke-linecap="round" stroke-dasharray="565.48" stroke-dashoffset="0"/>
            </svg>
            <div class="countdown-display"><div class="countdown-time" id="countdownTime">02:00</div><div class="countdown-label" data-en="Review Period" data-he="תקופת סקירה">Review Period</div></div>
          </div>
          <div class="countdown-complete" id="countdownComplete"><i class="fas fa-check-circle"></i><h3 data-en="REVIEW PERIOD COMPLETED" data-he="תקופת הסקירה הסתיימה">REVIEW PERIOD COMPLETED</h3><p data-en="Your dashboard is now accessible." data-he="לוח הבקרה שלך נגיש כעת.">Your dashboard is now accessible.</p></div>
          <button class="btn btn-gold btn-lg" id="dashboardBtn" style="display:none;" onclick="navigate('dashboard')" data-en="Open My Dashboard" data-he="פתח את לוח הבקרה שלי">Open My Dashboard</button>
        </div>
      </div>
    </div>
  </div>

  <!-- PAGE 6: DASHBOARD -->
  <div id="page-dashboard" class="page">
    <div class="panel dark-panel" style="text-align:center; padding:40px;">
      <div class="eyebrow" style="color:var(--gold-champagne);" data-en="Recognition Dashboard" data-he="לוח הוקרה">Recognition Dashboard</div>
      <h2 style="color:white;" data-en="Your Application <span class='gold-text'>Dashboard</span>" data-he="לוח הבקרה של <span class='gold-text'>הבקשה</span>">Your Application <span class="gold-text">Dashboard</span></h2>
    </div>
    <div class="stats-grid">
      <div class="stat-card"><div class="stat-icon"><i class="fas fa-chart-line"></i></div><div class="stat-info"><h4 data-en="Application Progress" data-he="התקדמות בקשה">Application Progress</h4><div class="stat-value">75%</div></div></div>
      <div class="stat-card"><div class="stat-icon"><i class="fas fa-file-alt"></i></div><div class="stat-info"><h4 data-en="Documents Received" data-he="מסמכים שהתקבלו">Documents Received</h4><div class="stat-value">3/4</div></div></div>
      <div class="stat-card"><div class="stat-icon"><i class="fas fa-calendar-day"></i></div><div class="stat-info"><h4 data-en="Days Since Submission" data-he="ימים מאז ההגשה">Days Since Submission</h4><div class="stat-value" id="statDays">—</div></div></div>
      <div class="stat-card"><div class="stat-icon"><i class="fas fa-hashtag"></i></div><div class="stat-info"><h4 data-en="Application Reference" data-he="מספר ייחוס">Application Reference</h4><div class="stat-value" id="statRef" style="font-size:1rem;">—</div></div></div>
    </div>
    <div class="panel">
      <h3 data-en="Seven-Stage Progress Tracker" data-he="מעקב התקדמות שבעת השלבים">Seven-Stage Progress Tracker</h3>
      <div class="timeline">
        <div class="timeline-item"><div class="timeline-dot done"></div><div class="timeline-card done"><h4 data-en="1. Initial Representative Enquiry" data-he="1. פנייה ראשונית של נציג">1. Initial Representative Enquiry</h4><p data-en="Status: Complete" data-he="סטטוס: הושלם">Status: Complete</p></div></div>
        <div class="timeline-item"><div class="timeline-dot done"></div><div class="timeline-card done"><h4 data-en="2. Eligibility & Identity Review" data-he="2. סקירת זכאות וזהות">2. Eligibility & Identity Review</h4><p data-en="Status: Complete" data-he="סטטוס: הושלם">Status: Complete</p></div></div>
        <div class="timeline-item"><div class="timeline-dot done"></div><div class="timeline-card done"><h4 data-en="3. Documentation Assessment" data-he="3. הערכת מסמכים">3. Documentation Assessment</h4><p data-en="Status: Complete" data-he="סטטוס: הושלם">Status: Complete</p></div></div>
        <div class="timeline-item"><div class="timeline-dot current"></div><div class="timeline-card current"><h4 data-en="4. Administrative Verification" data-he="4. אימות מנהלי">4. Administrative Verification</h4><p data-en="Status: Under Verification" data-he="סטטוס: באימות">Status: Under Verification</p></div></div>
