      <h2 style="color:white;" data-en="DELIVERY & <span class='gold-text'>SHIPMENT CENTER</span>" data-he="מרכז <span class='gold-text'>משלוחים והובלה</span>">DELIVERY & <span class="gold-text">SHIPMENT CENTER</span></h2>
    </div>
